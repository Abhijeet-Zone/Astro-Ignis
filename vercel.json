{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health" },
    { "source": "/api/calculate_fatigue", "destination": "/api/calculate_fatigue" },
    { "source": "/api/morse/:action*", "destination": "/api/morse/$action*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
